# -*- coding: utf-8 -*-
"""
本地私有配置示例 —— 复制成 config_local.py 后填入你自己的密钥。
config_local.py 已被 .gitignore 忽略，不会被提交到 Git。

用法：
    copy config_local.py.example config_local.py     (Windows: copy)
    然后把下面的 "" 换成你的真实 API Key。

也可以完全不用这个文件，改用环境变量：
    set WECHATBOT_API_KEY=sk-xxx
或者直接在网页控制台「🧠 AI 大脑」面板里填（推荐，最省事）。
"""

# 主对话模型（OpenAI 兼容接口：DeepSeek / 硅基流动 / Moonshot / 官方 OpenAI 都行）
API_KEY = ""
BASE_URL = "https://api.deepseek.com/v1"
MODEL = "deepseek-chat"

# 视觉识别（图片 / 表情包识别），来自 Moonshot 的免费额度；不需要就留空
MOONSHOT_API_KEY = ""
MOONSHOT_BASE_URL = "https://api.moonshot.cn/v1"
MOONSHOT_MODEL = "moonshot-v1-128k-vision-preview"
